// ═══════════════════════════════════════════
// PIR MOTION SENSOR SETTINGS
// ═══════════════════════════════════════════
#define PIR_PIN         14
#define TOILET_LED_PIN  26
#define PIR_HOLD_TIME   10000     // LED stays on for 10 seconds after LAST motion

// ═══════════════════════════════════════════
// PINS
// ═══════════════════════════════════════════
#define LED_PIN        2
#define FAN_PIN        25
#define DHT_PIN_ROOM   4
#define DHT_PIN_FRIDGE 15
#define FLAME_PIN      34
